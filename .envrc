# Inherit settings from any parent .envrc
source_up_if_exists

# Install the toolchain pinned in mise.toml, then load it into the shell
watch_file mise.toml
mise trust --quiet
mise install --quiet
eval "$(mise env --shell bash)"

# Install git hooks from lefthook.yml if missing or out of date
watch_file lefthook.yml
lefthook check-install || lefthook install

# Project helper scripts
PATH_add .local/bin
